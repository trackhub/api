# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type User {
  id: ID!
  name: String!
}

type Point {
  lat: Float!
  lng: Float!
}

type Query {
  listTracks(
    skipPlaces: [String!]
    skipTracks: [String!]
  ): [Track!]!
}

type Track {
    id: String!
    name: String
    slugOrId: String!
    points: [Point!]
    type: Int
}
