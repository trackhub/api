# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type User {
  id: ID!
  name: String!
}

type Point {
  lat: Float!
  lng: Float!
}

type Query {
  listTracks(
    skipPlaces: [String!]
    skipTracks: [String!]
  ): [Track!]!
}

input NewTodo {
  text: String!
  userId: String!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
}

type Track {
    id: String!
    name: String
    slugOrId: String!
    points: [Point!]
    type: Int
}
