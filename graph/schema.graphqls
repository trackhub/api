# GraphQL schema example
#
# https://gqlgen.com/getting-started/

enum Locale {
  en
  bg
}

type User {
  id: ID!
  name: String!
}

type Point {
  lat: Float!
  lng: Float!
}

type ElevatioinPoint {
  lat: Float!
  lng: Float!
  elevation: Float!
}

type TrackImage {
  id: ID!
  trackId: String!
  filepath: String!
}

type Query {
  track(idOrSlug: String!, locale: Locale): Track!

  listTracks(
    skipTracks: [String!]
    neLat: Float!
    swLat: Float!
    neLon: Float!
    swLon: Float!
    locale: Locale
  ): TrackListResult!

  latestTracks(type: Int!, locale: Locale): [Track!]!

  latestTrackImages: [TrackImage!]!

  place(idOrSlug: String!, locale: Locale): Place!

  listPlaces(
    skipPlaces: [String!]
    neLat: Float!
    swLat: Float!
    neLon: Float!
    swLon: Float!
    locale: Locale
  ): PlaceListResult!
}

type Place {
  attraction: Boolean!
  id: String!
  slugOrId: String!
  slug: String
  name: String
  icon: String
  lat: Float!
  lng: Float!
}

type Track {
  id: String!
  name: String
  slugOrId: String!
  points: [Point!]
  type: Int!
  versions: [TrackVersion!]
  optimizedPoints: [[Point!]]
}

type TrackVersion {
  id: String!
}

type PlaceListResult {
  places: [Place!]!
  status: Int!
}

type TrackListResult {
  tracks: [Track]!
  status: Int!
}
